<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Not Fertile"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <LinearLayout
            android:id="@+id/widget_full_days_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_days_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="#38BDF8"
                android:textSize="40sp"
                android:fontFamily="sans-serif-black"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_days_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:text="days"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_compact_days_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:maxLines="1"
            android:text="--"
            android:textColor="#38BDF8"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_compact_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:maxLines="1"
            android:text="Days"
            android:textColor="#38BDF8"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.9"
            android:text="to next period"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tap to open Maya"
            android:textColor="#7DD3FC"
            android:textSize="11sp"
            android:fontFeatureSettings="tnum" />

    </LinearLayout>

</FrameLayout>
